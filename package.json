    "del": "^6.1.1",
    "fancy-log": "^2.0.0",
    "gulp": "^3.9.1",
    "gulp-bump": "^3.2.0",
    "gulp-cache": "^1.1.3",
    "gulp-clean-css": "^4.3.0",
    "gulp-filter": "^7.0.0",
    "gulp-git": "^2.10.1",
    "gulp-if": "^3.0.0",
    "gulp-imagemin": "^7.1.0",
    "gulp-json-transform": "^0.5.0",
    "gulp-less": "^5.0.0",
    "gulp-livereload": "^4.0.2",
    "gulp-plumber": "^1.2.1",
    "gulp-sass": "^5.1.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-tag-version": "^1.3.1",
    "gulp-zip": "^5.1.0",
